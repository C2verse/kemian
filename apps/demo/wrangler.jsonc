{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kemian-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23libQayGUbDiz0gu9",
    "GITHUB_BASE_URL": "https://github.com",
    "GITHUB_API_BASE_URL": "https://api.github.com",
    "PRIVATE_IDENTITIES": "github:63489409",
    "EDITOR_IDENTITIES": "github:63489409",
  },
  "secrets": {
    "required": ["KEMIAN_PUBLISH_TOKEN", "KEMIAN_PROPOSALS_TOKEN", "GITHUB_CLIENT_SECRET"],
  },
  "r2_buckets": [
    {
      "binding": "BUNDLES",
      "bucket_name": "kemian-demo-bundles",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "7477c7ed59374a808482dc356fd3be44",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
